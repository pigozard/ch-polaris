<% content_for :title, @etp_program.name %>
<%# ═══════════ HERO ═══════════ %>
<section class="hub-hero" aria-labelledby="etp-program-title">
  <div class="container">
    <span class="label"><%= @etp_program.pathology_label %></span>
    <h1 id="etp-program-title"><%= @etp_program.name %></h1>
    <p><%= @etp_program.description %></p>
    <%= link_to "← Tous les programmes", etp_programs_path, class: "hub-switch-link" %>
  </div>
</section>

<div class="container">
  <section class="section section--no-border etp-detail">

    <dl class="etp-facts">
      <% if @etp_program.duration.present? %>
        <div><dt>Durée</dt><dd><%= @etp_program.duration %></dd></div>
      <% end %>
      <div><dt>Format</dt><dd><%= @etp_program.modality_label %></dd></div>
      <div><dt>Lieu</dt><dd><%= @etp_program.unit.name %></dd></div>
    </dl>

    <% if @etp_program.target_audience.present? %>
      <h2 class="etp-heading">À qui s'adresse ce programme ?</h2>
      <p><%= @etp_program.target_audience %></p>
    <% end %>

    <h2 class="etp-heading">Conditions pour participer</h2>
    <p><%= @etp_program.prerequisites %></p>

    <h2 class="etp-heading">Recrutement des groupes</h2>
    <% if (next_recruitment = @etp_program.next_recruitment) %>
      <p>Les groupes démarrent en <strong><%= @etp_program.recruitment_months_label %></strong>.</p>
      <p class="etp-recruitment">
        Prochain recrutement : <strong><%= l(next_recruitment, format: :month_year) %></strong>
      </p>
    <% else %>
      <p>Contactez l'UTEP pour connaître les prochaines dates de recrutement.</p>
    <% end %>

    <%= render "utep_contact", utep: @utep, subject: "Demande d'information — #{@etp_program.name}" %>

  </section>
</div>
