<% content_for :title, "Professionnels de santé" %>
<% accent = "#7C3AED" %> <%# violet des portes de l'accueil : 5.70:1 sur blanc AA %>

<!-- ═══════════ HUB HERO ═══════════ -->
<section class="hub-hero" style="--accent: <%= accent %>;" aria-labelledby="hub-title">
  <div class="container">
    <span class="label">Espace</span>
    <h1 id="hub-title">Professionnels <span class="hub-hero-accent">de santé</span></h1>
    <p>
      Les outils et ressources du Centre Hospitalier Polaris pour vous accompagner
      dans votre exercice : annuaire, programmes ETP et échelles cliniques.
    </p>
    <%= link_to "← Vous êtes patient ou proche ?", patients_path, class: "hub-switch-link" %>
  </div>
</section>

<div class="container">
  <section class="section section--no-border" style="--accent: <%= accent %>;">
    <div class="hub-grid">

      <%# ── LIVE : Annuaire des unités ── %>
      <%= link_to annuaire_path, class: "hub-card hub-card--live" do %>
        <span class="hub-card-icon" aria-hidden="true"><i class="fa-solid fa-address-book" aria-hidden="true"></i></span>
        <span class="hub-card-title">Annuaire des unités</span>
        <span class="hub-card-desc">Cherchez une unité par son nom ou par besoin (bipolaire, addiction, périnatalité…) : spécialités, contacts directs et secrétariats.</span>
        <span class="hub-card-cta">Consulter l'annuaire →</span>
      <% end %>

      <%# ── LIVE : Catalogue ETP ── %>
      <%= link_to etp_programs_path, class: "hub-card hub-card--live" do %>
        <span class="hub-card-icon" aria-hidden="true"><i class="fa-solid fa-book-open" aria-hidden="true"></i></span>
        <span class="hub-card-title">Catalogue ETP</span>
        <span class="hub-card-desc">Programmes d'éducation thérapeutique, public cible, prochaines sessions et contact de l'UTEP.</span>
        <span class="hub-card-cta">Consulter le catalogue →</span>
      <% end %>

      <%# ── LIVE quand les échelles seront codées (semaine 7) ── %>
      <div class="hub-card hub-card--soon">
        <span class="hub-badge">À venir</span>
        <span class="hub-card-icon" aria-hidden="true"><i class="fa-solid fa-chart-column" aria-hidden="true"></i></span>
        <span class="hub-card-title">Échelles cliniques</span>
        <span class="hub-card-desc">HAD, Hamilton, EVA : remplissage interactif, calcul automatique du score et interprétation.</span>
        <span class="hub-card-cta">Bientôt disponible</span>
      </div>

      <%# ── LIVE : Carte de l'établissement ── %>
      <%= link_to carte_path, class: "hub-card hub-card--live" do %>
        <span class="hub-card-icon" aria-hidden="true"><i class="fa-solid fa-map" aria-hidden="true"></i></span>
        <span class="hub-card-title">Carte de l'établissement</span>
        <span class="hub-card-desc">Plan interactif : recherchez une unité, sa zone s'illumine sur le plan de l'hôpital.</span>
        <span class="hub-card-cta">Ouvrir le plan →</span>
      <% end %>

      <%# ── Page contact — à créer quand tu veux ── %>
      <div class="hub-card hub-card--soon">
        <span class="hub-badge">À venir</span>
        <span class="hub-card-icon" aria-hidden="true"><i class="fa-solid fa-envelope" aria-hidden="true"></i></span>
        <span class="hub-card-title">Nous contacter</span>
        <span class="hub-card-desc">Standard, emails par pôle et coordonnées des secrétariats pour joindre la bonne personne.</span>
        <span class="hub-card-cta">Bientôt disponible</span>
      </div>

    </div>
  </section>
</div>
