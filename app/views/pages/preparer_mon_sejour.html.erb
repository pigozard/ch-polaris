<% content_for :title, "Préparer mon séjour" %>
<% accent = "#2563EB" %> <%# bleu des portes de l'accueil : 5.17:1 sur blanc AA %>

<%# ═══════════ HERO ═══════════ %>
<section class="hub-hero" style="--accent: <%= accent %>;" aria-labelledby="sejour-title">
  <div class="container">
    <span class="label">Hospitalisation</span>
    <h1 id="sejour-title">Préparer <span class="hub-hero-accent">mon séjour</span></h1>
    <p>
      Ce qu'il faut savoir avant d'arriver : le déroulé de l'admission, les documents à apporter,
      les affaires à prévoir et comment rejoindre votre unité.
    </p>
    <%= link_to "← Retour à l'espace patients", patients_path, class: "hub-switch-link" %>
  </div>
</section>

<div class="container sejour" style="--accent: <%= accent %>;">

  <%# ═══════════ ADMISSION ═══════════ %>
  <section class="section section--no-border" aria-labelledby="sejour-admission-title">
    <span class="label">Étape par étape</span>
    <h2 class="section-title" id="sejour-admission-title">Le jour de l'admission</h2>

    <%# Logigramme : deux entrées possibles, puis un tronc commun dans l'unité %>
    <div class="sejour-flow">
      <div class="sejour-flow-entries">
        <div class="sejour-flow-entry">
          <h3 class="sejour-flow-entry-title">
            <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
            Votre hospitalisation est programmée
          </h3>
          <p class="sejour-flow-box">
            <strong>Bureau des entrées</strong>, dans le hall principal : présentez vos documents
            pour ouvrir votre dossier administratif.
          </p>
        </div>

        <div class="sejour-flow-entry">
          <h3 class="sejour-flow-entry-title">
            <i class="fa-solid fa-truck-medical" aria-hidden="true"></i>
            Vous arrivez par les urgences psychiatriques
          </h3>
          <p class="sejour-flow-box">
            <strong>Admission faite aux <%= @emergency_unit&.name || "urgences psychiatriques" %></strong> :
            pas besoin de passer par le bureau des entrées. Si vous n'aviez pas vos documents,
            un proche pourra les apporter plus tard.
            <% if @emergency_unit&.phone.present? %>
              <span class="sejour-phone">
                Urgences psychiatriques :
                <a href="tel:<%= @emergency_unit.phone.delete(" ") %>"><%= @emergency_unit.phone %></a>
              </span>
            <% end %>
          </p>
        </div>
      </div>

      <div class="sejour-flow-merge" aria-hidden="true"></div>

      <p class="sejour-flow-then">Puis, dans les deux cas, dans votre unité&nbsp;:</p>
      <ol class="sejour-flow-steps">
        <li>
          <strong>Accueil dans l'unité</strong> par un infirmier, qui vous présente le service,
          votre chambre et les règles de vie.
        </li>
        <li>
          <strong>Entretien d'accueil et inventaire</strong> de vos effets personnels. Certains objets
          peuvent être confiés à l'équipe pendant votre séjour.
        </li>
        <li>
          <strong>Rencontre avec le psychiatre</strong> de l'unité, le jour même ou le lendemain.
        </li>
      </ol>
    </div>

    <p class="sejour-note">
      La plupart des hospitalisations se font en <strong>soins libres</strong>, avec votre accord.
      Dans certaines situations, des soins sans consentement peuvent être décidés : ils sont
      strictement encadrés par la loi, et vous gardez des droits (information, recours,
      personne de confiance).
      <%= link_to "Mes droits en psychiatrie →", mes_droits_path %>
    </p>
  </section>

  <%# ═══════════ DOCUMENTS & AFFAIRES ═══════════ %>
  <section class="section" aria-labelledby="sejour-bagage-title">
    <span class="label">Avant de partir</span>
    <h2 class="section-title" id="sejour-bagage-title">Ce qu'il faut apporter</h2>

    <div class="sejour-paths">
      <div class="sejour-path">
        <h3 class="sejour-path-title">Documents</h3>
        <ul class="sejour-checklist">
          <li><i class="fa-solid fa-id-card" aria-hidden="true"></i><span>Pièce d’identité</span></li>
          <li><i class="fa-solid fa-credit-card" aria-hidden="true"></i><span>Carte Vitale ou attestation de droits</span></li>
          <li><i class="fa-solid fa-shield-heart" aria-hidden="true"></i><span>Carte de mutuelle</span></li>
          <li><i class="fa-solid fa-prescription-bottle-medical" aria-hidden="true"></i><span>Ordonnances et traitements en cours, à remettre à l’équipe soignante</span></li>
          <li><i class="fa-solid fa-user-doctor" aria-hidden="true"></i><span>Coordonnées de votre médecin traitant</span></li>
          <li><i class="fa-solid fa-handshake" aria-hidden="true"></i><span>Nom et coordonnées de votre personne de confiance, si vous en avez désigné une</span></li>
        </ul>
      </div>

      <div class="sejour-path">
        <h3 class="sejour-path-title">Affaires personnelles</h3>
        <ul class="sejour-checklist">
          <li><i class="fa-solid fa-shirt" aria-hidden="true"></i><span>Vêtements confortables pour plusieurs jours</span></li>
          <li><i class="fa-solid fa-pump-soap" aria-hidden="true"></i><span>Produits d’hygiène</span></li>
          <li><i class="fa-solid fa-book" aria-hidden="true"></i><span>De quoi lire ou vous occuper</span></li>
          <li class="sejour-checklist-avoid"><i class="fa-solid fa-gem" aria-hidden="true"></i><span>Évitez les objets de valeur et les grosses sommes d’argent</span></li>
        </ul>
        <p>
          Chaque unité a son propre règlement (objets autorisés ou interdits, horaires de visite).
          <%= link_to "Consultez le règlement de votre unité dans l'annuaire →", annuaire_path %>
        </p>
      </div>
    </div>
  </section>

  <%# ═══════════ ACCÈS ═══════════ %>
  <section class="section" aria-labelledby="sejour-acces-title">
    <span class="label">Venir à l'hôpital</span>
    <h2 class="section-title" id="sejour-acces-title">Accès et stationnement</h2>

    <p>
      Centre Hospitalier Polaris — 12 rue des Astres, 99999 Novapolis.
      Le stationnement et l'entrée à utiliser dépendent de votre unité.
      <%= link_to "Voir le plan de l'établissement →", carte_path %>
    </p>

    <% if @all_pmr_accessible %>
      <p class="sejour-pmr">
        <i class="fa-solid fa-wheelchair" aria-hidden="true"></i>
        Toutes les unités d'hospitalisation sont accessibles aux personnes à mobilité réduite.
      </p>
    <% end %>

    <%# Une carte par parking : on cherche son unité, on trouve son parking et son entrée %>
    <div class="sejour-parkings">
      <% @parkings.each do |parking_info, units| %>
        <% name, access = Unit.split_parking_info(parking_info) %>
        <section class="sejour-parking" aria-label="<%= name.presence || "Stationnement à confirmer" %>">
          <h3 class="sejour-parking-name">
            <i class="fa-solid fa-square-parking" aria-hidden="true"></i>
            <%= name.presence || "Stationnement à confirmer" %>
          </h3>
          <p class="sejour-parking-access"><%= access.presence || "Renseignez-vous auprès de l'unité" %></p>
          <ul class="sejour-parking-units">
            <% units.each do |unit| %>
              <li>
                <%= unit.name %>
                <% unless unit.pmr_accessible? %>
                  <span class="sejour-parking-no-pmr">(non accessible PMR)</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  </section>

  <%# ═══════════ URGENCE ═══════════ %>
  <section class="section">
    <div class="hub-urgence" role="complementary" aria-label="Numéros d'urgence">
      <span aria-hidden="true" style="font-size:1.4rem;"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></span>
      <div>
        <strong>En cas de crise ou d'urgence psychiatrique</strong>
        <div class="hub-urgence-num">
          SAMU <strong>15</strong> · Prévention suicide <strong>3114</strong> (24h/24, gratuit)
        </div>
      </div>
    </div>
  </section>

</div>
