<!DOCTYPE html>
<html lang="fr">
  <head>
    <%# Titre d'onglet propre à chaque page (WCAG 2.4.2) : chaque vue déclare content_for :title %>
    <title><%= content_for?(:title) ? safe_join([yield(:title), " — CH Polaris"]) : "CH Polaris — Centre Hospitalier Psychiatrique" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Centre Hospitalier Psychiatrique Polaris — Établissement Public de Santé dédié à la psychiatrie adulte, pédopsychiatrie et addictologie à Novapolis.">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "polaris", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body>
    <a href="#main-content" class="skip-nav">Aller au contenu principal</a>
    <%= render "shared/demo_banner" %>
    <%= render "shared/navbar" %>
    <%= render "shared/flashes" %>
    <main id="main-content">
      <%= yield %>
    </main>
  </body>
</html>
